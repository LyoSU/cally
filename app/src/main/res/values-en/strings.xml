    <!-- Accessibility — required for reliable background FG service start -->
    <string name="accessibility_service_summary">Enables automatic call recording</string>
    <string name="accessibility_service_description">cally uses an accessibility service to reliably start recording automatically when a call comes in. We don\'t read any events — the service is only needed for permission to start recording in the background.</string>

    <!-- Onboarding step 5 (overlay permission for FGS-from-background) -->
    <string name="onboarding_step_overlay">Display over other apps</string>
    <string name="onboarding_step_overlay_desc">Permission to draw over other apps — required for background auto-recording. We add an invisible 1×1 px layer for ~3 seconds so Android allows recording to start during a call.</string>
    <string name="onboarding_step_overlay_action">Allow</string>

    <!-- Onboarding step 6 (battery exemption) -->
    <string name="onboarding_step_battery">No sleeping</string>
    <string name="onboarding_step_battery_desc">Samsung and Pixel freeze apps when they are off-screen. Without this permission, cally can\'t wake itself up to record a call.</string>
    <string name="onboarding_step_battery_action">Allow</string>

